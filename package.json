{
  "name": "handshakeiq",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx server/index.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:liveness": "node --import tsx/esm --test server/jobs/jobMatchService.liveness.test.ts",
    "test:audit": "node --import tsx/esm --test server/jobs/jobMatchService.audit.test.ts",
    "test:schedule": "node --import tsx/esm --test server/jobs/jobMatchService.schedule.test.ts",
    "test:fallback": "node --import tsx/esm --experimental-test-module-mocks --test services/intelligenceService.fallback.test.ts",
    "test:register": "node --import tsx/esm --experimental-test-module-mocks --test server/routes.register.test.ts",
    "test:contacts": "node --import tsx/esm --test server/jobs/contactDiscovery.test.ts",
    "test:google-discovery": "node --import tsx/esm --test server/jobs/googleDiscovery.test.ts",
    "test:cv-checker": "node --import tsx/esm --test server/jobs/cvParseChecker.test.ts",
    "test:recheck": "node --import tsx/esm --test server/jobs/recheckShortlist.test.ts",
    "test:recheck-live": "node --import tsx/esm --test server/jobs/jobMatchService.recheckProtection.test.ts",
    "test:session-expiry": "node --import tsx/esm --test server/jobs/atsSubmitter/sessionExpiry.test.ts",
    "test:recover-stuck": "node --import tsx/esm --test server/jobs/applyService.recoverStuck.test.ts",
    "test:aggregators": "node --import tsx/esm --test server/jobs/aggregatorDiscovery.test.ts",
    "test:apply": "node --import tsx/esm --test server/jobs/aiClient.test.ts server/jobs/applyService.test.ts server/jobs/applyService.dedup.test.ts server/jobs/applyService.recoverStuck.test.ts server/jobs/atsSubmitter/core.test.ts server/jobs/atsSubmitter/browser.test.ts server/jobs/atsSubmitter/fill.test.ts server/jobs/atsSubmitter/experienceFill.test.ts server/jobs/atsSubmitter/screeningAnswer.test.ts server/jobs/atsSubmitter/sessionExpiry.test.ts server/jobs/atsSubmitter/vault.test.ts server/jobs/atsSubmitter/handoff.test.ts server/jobs/atsSubmitter/passwordReset.test.ts",
    "test:components": "vitest run --config vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@google/genai": "^1.29.0",
    "@tanstack/react-query": "^5.90.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.5",
    "@types/express-session": "^1.18.2",
    "@types/memoizee": "^0.4.12",
    "@types/node-cron": "^3.0.11",
    "@types/passport": "^1.0.17",
    "@types/pdfkit": "^0.17.6",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.5.0",
    "googleapis": "^165.0.0",
    "jsdom": "^29.1.1",
    "memoizee": "^0.4.17",
    "node-cron": "^4.6.0",
    "openid-client": "^6.8.1",
    "passport": "^0.7.0",
    "pdfkit": "^0.19.1",
    "playwright-core": "^1.62.1",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
